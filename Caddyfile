# Replace zeitspiel.vfl-bochum.de with your actual domain.
# Caddy automatically provisions Let's Encrypt certificates.
{$DOMAIN:zeitspiel.example.de} {
    reverse_proxy web:3000

    # Extra headers — app already sets most via next.config,
    # these are belt-and-braces in case the proxy strips them.
    header {
        X-Frame-Options "DENY"
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        -Server
    }

    # Compression
    encode gzip zstd

    # Static asset caching is already handled by Next, just pass-through.
    log {
        output stdout
        format console
    }
}
