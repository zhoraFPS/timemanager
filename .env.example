# Timezone — muss auf deutsche Zeit stehen, sonst driften Stempel-Tage
# und Feiertags-Abzug. In Docker Compose bereits gesetzt.
TZ="Europe/Berlin"

# Postgres (nur fuer docker-compose relevant)
POSTGRES_DB="zeitspiel"
POSTGRES_USER="zeitspiel"
POSTGRES_PASSWORD=""

# Reverse-Proxy — Domain fuer Caddy
DOMAIN="zeitspiel.example.de"
APP_PORT="3000"
API_PORT="3001"

DATABASE_URL="postgresql://zeiterfassung:password@localhost:5432/zeiterfassung"

# NextAuth v5 (Web-Session)
AUTH_SECRET="supersecret-change-in-production-min-32-chars"
NEXTAUTH_SECRET="supersecret-change-in-production-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Web Push Notifications — generiere mit: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@vflbochum.de"

# SMTP (optional — Fallback auf in der App konfigurierten Passwort-Wert)
SMTP_PASSWORD=""

# Microsoft Entra ID (Azure AD) — optional. Wenn alle drei gesetzt sind,
# erscheint "Mit Microsoft anmelden" auf der Login-Seite.
# Issuer-URL: https://login.microsoftonline.com/<TENANT_ID>/v2.0
# Redirect-URI (im Azure-Portal eintragen): <BASE_URL>/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""

# Cron-Secret fuer Auto-Clockout-Endpoint (stuendlicher Vercel-Cron).
# Bei lokaler Ausfuehrung als Bearer-Token nutzen: curl -H "Authorization: Bearer $CRON_SECRET" ...
CRON_SECRET=""

# Sentry — Error-Tracking. Beide DSNs sind dieselbe, aber getrennt damit der
# public DSN clientseitig sichtbar sein darf (gewolltes Verhalten).
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
